🔍 COMPREHENSIVE LIKE OPERATOR EXAMPLES WITH % WILDCARD
═══════════════════════════════════════════════════════════════════════════════════

1. PATTERN: WHERE CustomerName LIKE 'a%'
   DESCRIPTION: Finds any values that start with "a" (at the beginning)
   MATCHES:
   • 'alfreds' - Starts with 'a'
   • 'ana' - Starts with 'a'
   • 'antonio' - Starts with 'a'
   • 'around' - Starts with 'a'
   
   QUERY EXAMPLE:
   SELECT * FROM Customers WHERE CustomerName LIKE 'a%';
   
   USE CASE: Finding all customer names beginning with a specific letter


2. PATTERN: WHERE CustomerName LIKE '%a'
   DESCRIPTION: Finds any values that end with "a" (at the end)
   MATCHES:
   • 'anna' - Ends with 'a'
   • 'maria' - Ends with 'a'
   • 'helena' - Ends with 'a'
   
   QUERY EXAMPLE:
   SELECT * FROM Customers WHERE CustomerName LIKE '%a';
   
   USE CASE: Finding names with specific endings


3. PATTERN: WHERE CustomerName LIKE '%or%'
   DESCRIPTION: Finds any values that have "or" in ANY position (beginning, middle, or end)
   MATCHES:
   • 'Moreno' - Contains 'or' in the middle
   • 'Antonio' - Contains 'or' in the middle
   • 'corridor' - Contains 'or' in the middle
   
   QUERY EXAMPLE:
   SELECT * FROM Customers WHERE CustomerName LIKE '%or%';
   
   USE CASE: Finding records containing a specific substring anywhere in the column


4. PATTERN: WHERE ContactName LIKE 'a%o'
   DESCRIPTION: Finds values that START with "a" and END with "o"
   MATCHES:
   • 'antonio' - Starts with 'a' AND ends with 'o'
   • 'alonso' - Starts with 'a' AND ends with 'o'
   • 'alejandro' - Starts with 'a' AND ends with 'o'
   
   QUERY EXAMPLE:
   SELECT * FROM Customers WHERE ContactName LIKE 'a%o';
   
   USE CASE: Finding records matching both beginning and ending patterns


5. PATTERN: WHERE City LIKE 'ber%'
   DESCRIPTION: Finds all cities starting with "ber"
   MATCHES:
   • 'Berlin' - Starts with 'ber'
   • 'Bern' - Starts with 'ber'
   • 'Bergamo' - Starts with 'ber'
   
   QUERY EXAMPLE:
   SELECT * FROM Customers WHERE City LIKE 'ber%';
   
   USE CASE: Finding records in cities starting with specific letters/pattern


6. PATTERN: WHERE City LIKE '%es%'
   DESCRIPTION: Finds all cities containing the pattern "es" anywhere
   MATCHES:
   • 'Manchester' - Contains 'es'
   • 'Brest' - Contains 'es'
   • 'Budapest' - Contains 'es'
   
   QUERY EXAMPLE:
   SELECT * FROM Customers WHERE City LIKE '%es%';
   
   USE CASE: Finding records with a specific substring in the middle


